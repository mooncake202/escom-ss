# Plantilla de variables de entorno (copiar a .env y completar). NUNCA versionar .env con valores reales.
# docker-compose.yml interpola estas variables; el backend solo recibe las que estén en su bloque `environment:`.

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=

# ── Base de datos (MariaDB) ──────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_URL=

# ── Autenticación ────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=4h

# ── Correo (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cifrado de documentos (AES-256-GCM): 64 caracteres hex → openssl rand -hex 32 ──
ENCRYPTION_KEY=

# ── Sello de tiempo RFC 3161 (TSA) ───────────────────────────
# TSA principal. Vacío = https://freetsa.org/tsr (comportamiento original).
TSA_URL=https://freetsa.org/tsr
# TSA de respaldo, solo se usa si la principal falla (red, timeout o respuesta inválida). Vacío = sin respaldo.
# Recomendada: DigiCert (pública, gratuita, RFC 3161 con SHA-256). Sus sellos se verifican con
# backend/src/lib/fixtures-tsa/digicert/DigiCertTrustedRootG4.crt, no con la CA de FreeTSA.
TSA_URL_RESPALDO=http://timestamp.digicert.com
# Tiempo máximo de espera por TSA, en milisegundos (con respaldo, el peor caso es el doble). Vacío = 15000.
TSA_TIMEOUT_MS=15000
